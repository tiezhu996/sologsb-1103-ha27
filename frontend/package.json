{
  "name": "gbcuesheet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 21803",
    "verify:import": "mkdir -p node_modules/.cache && esbuild scripts/verify-import.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-import.mjs --alias:@=./src && node node_modules/.cache/verify-import.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "naive-ui": "^2.45.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
